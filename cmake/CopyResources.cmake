if(NOT DEFINED SOURCE_DIR)
	message(FATAL_ERROR "SOURCE_DIR is required")
endif()
if(NOT DEFINED DESTINATION_DIR)
	message(FATAL_ERROR "DESTINATION_DIR is required")
endif()
if(NOT DEFINED STAMP_FILE)
	message(FATAL_ERROR "STAMP_FILE is required")
endif()
file(MAKE_DIRECTORY "${DESTINATION_DIR}")
file(GLOB_RECURSE RESOURCE_FILES RELATIVE "${SOURCE_DIR}" "${SOURCE_DIR}/*")
foreach(RELATIVE_RESOURCE IN LISTS RESOURCE_FILES)
	set(SOURCE "${SOURCE_DIR}/${RELATIVE_RESOURCE}")
	set(DESTINATION "${DESTINATION_DIR}/${RELATIVE_RESOURCE}")
	get_filename_component(DESTINATION_DIR "${DESTINATION}" DIRECTORY)
	file(MAKE_DIRECTORY "${DESTINATION_DIR}")
	file(COPY "${SOURCE}" DESTINATION "${DESTINATION_DIR}")
endforeach()
execute_process(COMMAND ${CMAKE_COMMAND} -E touch "${STAMP_FILE}")
